    "executionArchitecture": "EITHER64OR32BIT",
    "timeout": 180,
    "appCatalog": {
      "enabled": false,
      "displayName": "",
      "displayDescription": "",
      "category": ""
    },
    "variables": [
      {
        "key": "esr_wifi_keep",
        "value": "CorpWiFi,CorpWiFi-Guest"
      }
