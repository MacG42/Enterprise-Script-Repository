  "workspaceOne": {
    "language": "ZSH",
    "executionContext": "SYSTEM",
    "timeout": 300,
    "appCatalog": {
      "enabled": false,
      "displayName": "",
      "displayDescription": "",
      "category": ""
    },
    "variables": [
      {
        "key": "esr_launch_allowlist",
        "value": "com.airwatch,com.vmware,com.omnissa,com.microsoft"
      }
    ]
