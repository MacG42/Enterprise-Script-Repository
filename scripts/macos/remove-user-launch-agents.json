  "version": "1.0.0",
  "release": "production",
  "os": "macOS",
  "icon": "🧹",
  "author": "macg@macgworld.com",
  "tags": [
    "launchagents",
    "persistence",
    "security",
    "userprofile"
  ],
  "created": "2026-09-06T12:00:00Z",
  "modified": "2026-09-06T12:00:00Z",
  "workspaceOne": {
    "language": "ZSH",
    "executionContext": "USER",
    "timeout": 300,
    "appCatalog": {
      "enabled": false,
      "displayName": "",
      "displayDescription": "",
      "category": ""
    },
    "variables": [
      {
        "key": "esr_launch_allowlist",
        "value": "com.airwatch,com.vmware,com.omnissa,com.microsoft,com.google"
      }
    ]
  },
