  "workspaceOne": {
    "language": "ZSH",
    "executionContext": "SYSTEM",
    "timeout": 300,
    "appCatalog": {
      "enabled": false,
      "displayName": "",
      "displayDescription": "",
      "category": ""
    },
    "variables": [
      {
        "key": "esr_wifi_keep",
        "value": "CorpWiFi,CorpWiFi-Guest"
